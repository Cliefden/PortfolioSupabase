        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det gick inte att logga in med Apple: %@"
          }
        }
      }
    },
    "Couldn't connect. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Verbindung möglich. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo conectar. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connexion impossible. Vérifiez votre connexion et réessayez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det gick inte att ansluta. Kontrollera anslutningen och försök igen."
          }
        }
      }
    },
    "Enter your email address": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gib deine E-Mail-Adresse ein"
