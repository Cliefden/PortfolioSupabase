        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fel e-postadress eller lösenord."
          }
        }
      }
    },
    "Name can be at most %lld characters": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Name darf höchstens %lld Zeichen lang sein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El nombre puede tener como máximo %lld caracteres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le nom ne peut pas dépasser %lld caractères"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Namnet får vara högst %lld tecken"
          }
        }
      }
    },
    "New sign-ups are currently closed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neue Registrierungen sind derzeit nicht möglich."
