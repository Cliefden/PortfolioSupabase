    },
    "That password is too weak. Choose a longer one or mix letters, numbers and symbols.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Passwort ist zu schwach. Wähle ein längeres oder kombiniere Buchstaben, Ziffern und Symbole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La contraseña es demasiado débil. Elige una más larga o combina letras, números y símbolos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce mot de passe est trop faible. Choisissez-en un plus long ou mélangez lettres, chiffres et symboles."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lösenordet är för svagt. Välj ett längre eller blanda bokstäver, siffror och symboler."
          }
        }
      }
    },
