    "That code is wrong or has expired. Check the email, or send a new code.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Code ist falsch oder abgelaufen. Prüfe die E-Mail oder fordere einen neuen Code an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El código es incorrecto o ha caducado. Revisa el correo o solicita un código nuevo."
