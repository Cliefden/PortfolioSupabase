    "Incorrect email or password.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "E-Mail-Adresse oder Passwort ist falsch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Correo electrónico o contraseña incorrectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adresse e-mail ou mot de passe incorrect."
          }
