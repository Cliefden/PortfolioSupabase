{
  "sourceLanguage": "en",
  "strings": {
    "An account with this email already exists. Sign in instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es gibt bereits ein Konto mit dieser E-Mail-Adresse. Melde dich stattdessen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya existe una cuenta con este correo electrónico. Inicia sesión en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un compte existe déjà avec cette adresse e-mail. Connectez-vous plutôt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det finns redan ett konto med den här e-postadressen. Logga in i stället."
          }
        }
      }
    },
    "Choose a password different from your current one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle ein anderes Passwort als dein aktuelles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige una contraseña distinta de la actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un mot de passe différent de l'actuel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Välj ett annat lösenord än ditt nuvarande."
          }
        }
      }
    },
    "Confirm your email address first. Check your inbox for the link.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bestätige zuerst deine E-Mail-Adresse. Den Link findest du in deinem Posteingang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Primero confirma tu correo electrónico. Busca el enlace en tu bandeja de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confirmez d'abord votre adresse e-mail. Le lien se trouve dans votre boîte de réception."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bekräfta din e-postadress först. Titta efter länken i din inkorg."
          }
        }
      }
    },
    "Continue with Apple": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit Apple fortfahren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuar con Apple"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuer avec Apple"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsätt med Apple"
          }
        }
      }
    },
    "Could not sign in with Apple. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Anmeldung mit Apple ist fehlgeschlagen. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo iniciar sesión con Apple. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de se connecter avec Apple. Veuillez réessayer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det gick inte att logga in med Apple. Försök igen."
          }
        }
      }
    },
    "Could not sign in with Apple: %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Anmeldung mit Apple ist fehlgeschlagen: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo iniciar sesión con Apple: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de se connecter avec Apple : %@"
